flow_version 1

app desktop {
  collection Desktop {
    id: text
    schemaVersion: integer
    createdAt: integer
    userName: text?
    userAvatar: text?
    migration: json?
  }

  collection Setting {
    id: text
    value: json
    updatedAt: integer
  }

  collection Provider {
    id: text
    kind: text
    name: text
    config: json?
    credentialRef: text?
    updatedAt: integer
  }

  collection Agent {
    id: text
    name: text
    provider: text
    model: text
    createdAt: integer
    revision: integer?
    localAgentId: text?
    config: json?
  }

  collection AgentProfile {
    id: text
    agentId: text
    files: json?
    updatedAt: integer
    index by_agent using index agentId
  }

  collection Workspace {
    id: text
    path: text
    createdAt: integer
    name: text?
    isGit: boolean?
    testCommand: json?
    updatedAt: integer?
    index by_path using index path
  }

  collection CodingSession {
    id: text
    workspaceId: text
    agentId: text
    sessionId: text
    topicId: text
    cwd: text
    task: text
    status: text
    createdAt: integer
    startedAt: integer?
    finishedAt: integer?
    runId: text?
    error: text?
    result: text?
    baseline: json?
    changes: json?
    commands: json?
    events: json?
    cleaned: json?
    finalHead: text?
    // Where the agent runs: a reference to a Compute environment and repository, never a copy of the Computer's state.
    execution: json?
    index by_workspace using index workspaceId
    index by_agent using index agentId
    index by_session using index sessionId
  }

  // A CI run on an ephemeral Compute Computer: what was tested, PAX's plan, bounded results, and references to the Computer. Never source,
  // artifacts or the Computer's own state — Compute owns the Computer, and it is gone once released.
  collection CiRun {
    id: text
    workspaceId: text
    number: integer
    status: text
    phase: text
    createdAt: integer
    startedAt: integer?
    finishedAt: integer?
    source: json
    platform: json?
    computer: json?
    plan: json?
    operations: json?
    failure: json?
    events: json?
    index by_workspace using index workspaceId
  }

  // Structured evidence supplied to an evaluation. These are generic Foundry records: Jev is
  // the evaluator, while FeltDB remains the one durable application-state authority.
  collection Evidence {
    id: text
    evaluationId: text
    questionId: text
    inputId: text
    name: text
    value: json
    relevance: json
    createdAt: integer
    index by_evaluation using index evaluationId
    index by_question using index questionId
  }

  collection Evaluation {
    id: text
    questionId: text
    question: json
    result: json
    context: json
    projectId: text?
    invariantId: text?
    createdAt: integer
    index by_question using index questionId
    index by_project using index projectId
  }

  collection Decision {
    id: text
    evaluationId: text
    questionId: text
    value: json
    status: text
    createdAt: integer
    index by_evaluation using index evaluationId
    index by_question using index questionId
  }

  // A project's development environment: a *reference* to a Compute environment (its name, its id, the recipe that was asked for) and
  // nothing else. The environment's state, readiness, recipe provenance and lifecycle are Compute's and are asked of it every time.
  collection DevelopmentEnvironment {
    id: text
    workspaceId: text
    environment: text
    environmentId: text?
    recipe: json?
    createdAt: integer
    index by_workspace using index workspaceId
  }

  collection LocalAgentDefinition {
    id: text
    name: text
    command: text
    args: json?
    avatar: text?
    position: integer
    updatedAt: integer
  }

  // A note of the agent/command processes Foundry started, so the next start can stop any the last run left behind.
  collection AgentProcess {
    id: text
    pid: integer
    role: text
    identity: text
    cwd: text?
    startedAt: integer
  }

  // ── AppPort Services (capability `api`) ─────────────────────────────────────────────
  // Declared here, verbatim from AppPort Services' own contract, because Foundry and the AppPort
  // Services it consumes share this one flow: one FeltDB authority, several owners. Foundry never
  // reads or writes these collections itself; AppPort Services does, through its capabilities.
  collection ApiKeys {
    id: uuid
    tenant_id: text
    application_id: text
    name: text
    key_prefix: text
    secret_hash: text
    scopes: text
    created_at: datetime
    expires_at: datetime
    revoked_at: datetime
    last_used_at: datetime
    created_by: text
    index tenant_idx using hash(tenant_id)
    index prefix_idx using hash(key_prefix)
  }

  collection ApiKeyPrefixes {
    id: text
    api_key_id: uuid
    tenant_id: text
    created_at: datetime
    index tenant_prefix_idx using hash(tenant_id)
  }

  collection ApiKeyAuditEvents {
    id: uuid
    type: text
    credential_id: uuid
    tenant_id: text
    principal_id: text
    timestamp: datetime
    result: text
    index tenant_timestamp_idx using hash(tenant_id)
  }

  collection ServiceEffectEvidence {
    id: uuid
    application: text
    tenant_id: text
    principal_id: text
    principal_type: text
    delegation_id: text
    run_id: text
    capability: text
    capability_version: integer
    resource: text
    decision: text
    decision_id: text
    credential_ref: text
    service: text
    provider: text
    request_id: text
    started_at: datetime
    completed_at: datetime
    outcome: text
    failure_code: text
    index tenant_idx using hash(tenant_id)
    index capability_idx using hash(capability)
  }


  // ── @appport/github ────────────────────────────────────────────────────────────────
  // The GitHub capability's own collections, verbatim from its feltdb.flow (`await github.flow()`), in
  // the same flow for the same reason: Foundry, AppPort Services and @appport/github are owners of
  // different collections in one FeltDB authority. Foundry does not read or write these; the
  // capability does. Credentials never appear here — a connection holds only a secret *reference*.
  collection GitHubConnection {
    credential_reference: json
    auth_mechanism: text
    status: text
    tenant_id: text
    application_id: text
    environment: text
    provider: text
    created_at: datetime
    updated_at: datetime
    index tenant_id using hash(tenant_id)
    index status using hash(status)
  }

  collection GitHubInstallation {
    connection_id: text
    installation_id: integer
    account_login: text
    account_type: text
    target_type: text
    created_at: datetime
    updated_at: datetime
    index connection_id using hash(connection_id)
    index installation_id using hash(installation_id)
  }

  collection GitHubRepository {
    connection_id: text
    owner: text
    name: text
    node_id: text
    default_branch: text
    private: boolean
    archived: boolean
    updated_at: datetime
    index connection_id using hash(connection_id)
    index owner using hash(owner)
  }

  collection GitHubWebhookEvent {
    delivery_id: text
    event_name: text
    action: text
    connection_id: text
    repository_full_name: text
    status: text
    signature_valid: boolean
    received_at: datetime
    processed_at: datetime
    index delivery_id using hash(delivery_id)
    index event_name using hash(event_name)
  }

  collection GitHubOperation {
    capability: text
    principal_id: text
    tenant_id: text
    application_id: text
    connection_id: text
    resource_type: text
    resource_id: text
    status: text
    created_at: datetime
    updated_at: datetime
    index capability using hash(capability)
    index connection_id using hash(connection_id)
  }

  collection GitHubEvidence {
    operation_id: text
    capability: text
    principal_id: text
    tenant_id: text
    application_id: text
    result: text
    github_resource: json
    created_at: datetime
    index operation_id using hash(operation_id)
  }


  collection RuntimeBinding {
    id: text
    agentId: text
    sessionKey: text
    generation: text
    fingerprint: text
    thread: text?
    claudeAccountLogin: boolean?
    updatedAt: integer
    index by_agent using index agentId
  }

  collection Session {
    id: text
    kind: text
    title: text
    status: text
    agentId: text?
    workspaceId: text?
    provider: text?
    model: text?
    activeTopicId: text
    createdAt: integer
    updatedAt: integer
    revision: integer?
    meta: json?
    index by_agent using index agentId
  }

  collection Topic {
    id: text
    topicId: text
    sessionId: text
    title: text
    createdAt: integer
    updatedAt: integer
    contextResetId: text?
    contextResetAt: integer?
    index by_session using index sessionId
  }

  collection Group {
    id: text
    sessionId: text
    name: text
    description: text?
    leadAgentId: text?
    autoNamed: boolean?
  }

  collection GroupMember {
    id: text
    groupId: text
    agentId: text
    position: integer
    index by_group using index groupId
    index by_agent using index agentId
  }

  collection Message {
    id: text
    sessionId: text
    topicId: text
    role: text
    authorId: text
    authorName: text
    content: text
    kind: text
    timestamp: integer
    metadata: json?
    index by_topic using index sessionId,topicId
    index by_session using index sessionId
  }

  collection PrivateMessage {
    id: text
    sessionId: text
    topicId: text
    senderId: text
    recipientId: text
    content: text
    timestamp: integer
    metadata: json?
    index by_topic using index sessionId,topicId
    index by_agent_sender using index senderId
    index by_agent_recipient using index recipientId
  }

  collection Run {
    id: text
    agentId: text
    sessionId: text
    scheduleId: text?
    status: text
    title: text
    createdAt: integer
    startedAt: integer?
    finishedAt: integer?
    metadata: json?
    index by_agent using index agentId
    index by_schedule using index scheduleId
    index by_session using index sessionId
  }

  collection ExecutionEvent {
    id: text
    runId: text
    sessionId: text?
    type: text
    label: text
    status: text?
    detail: text?
    timestamp: integer
    index by_run using index runId
  }

  collection ToolExecution {
    id: text
    runId: text?
    sessionId: text
    messageId: text?
    tool: text
    status: text
    target: text?
    startedAt: integer
    finishedAt: integer?
    index by_session using index sessionId
    index by_run using index runId
  }

  collection Memory {
    id: text
    scope: text
    agentId: text?
    groupId: text?
    revision: integer
    updatedAt: integer
    document: json
    index by_agent using index agentId
    index by_group using index groupId
  }

  collection Schedule {
    id: text
    agentId: text
    sessionId: text
    name: text
    enabled: boolean
    nextRunAt: integer
    createdAt: integer
    updatedAt: integer
    definition: json
    index by_agent using index agentId
    index by_session using index sessionId
  }

  collection Attachment {
    id: text
    kind: text
    name: text
    size: integer
    mimeType: text?
    blob: text
    createdAt: integer
  }

  collection AttentionItem {
    id: text
    kind: text
    title: text
    sessionId: text?
    runId: text?
    createdAt: integer
    resolvedAt: integer?
    detail: text?
    index by_session using index sessionId
  }

  collection GroupState {
    id: text
    sessionId: text
    topicId: text
    kind: text
    revision: integer?
    document: json
    index by_session using index sessionId
    index by_topic using index sessionId,topicId
  }
}
